+/** The parsed value of each well-formed line of `text`, in order; blank and malformed lines are skipped. */
+export function jsonlValues(text: string): unknown[] {
+	const values: unknown[] = [];
+	for (const line of jsonlLines(text)) if (line.ok) values.push(line.value);
+	return values;
+}
