{
	"name": "@octocodeai/octocode-projections",
	"private": true,
	"version": "1.3.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"license": "MIT",
	"scripts": {
		"build": "shx rm -rf dist && tsc -p tsconfig.build.json",
		"clean": "shx rm -rf dist",
		"prepublishOnly": "yarn run clean && yarn run build",
		"test": "vitest run"
	},
	"dependencies": {
		"@octocodeai/octocode-contracts": "1.3.0"
	},
	"devDependencies": {
		"shx": "^0.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
