{
	"name": "@octocodeai/octocode-common",
	"version": "1.3.0",
	"private": true,
	"type": "module",
	"description": "Private host-free utilities shared by the Octocode workspace packages",
	"exports": {
		"./*": {
			"source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"scripts": {
		"build": "shx rm -rf dist && tsc -p tsconfig.build.json",
		"clean": "shx rm -rf dist",
		"prepublishOnly": "yarn run clean && yarn run build",
		"test": "vitest --run"
	},
	"dependencies": {
		"@octocodeai/octocode-contracts": "1.3.0",
		"cross-spawn": "^7.0.6",
		"proper-lockfile": "^4.1.2"
	},
	"devDependencies": {
		"@types/cross-spawn": "^6.0.6",
		"@types/node": "^24.19.2",
		"@types/proper-lockfile": "^4.1.4",
		"shx": "^0.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"license": "MIT",
	"engines": {
		"node": ">=24.15.0"
	},
	"files": [
		"dist",
		"README.md"
	]
}
