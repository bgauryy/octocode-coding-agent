{
	"name": "@octocodeai/octocode-agentic-testkit",
	"version": "0.0.0-poc",
	"private": true,
	"type": "module",
	"description": "Vitest-native behavior tests for agents: model gateway, MCP mocks, traces and matchers (POC)",
	"main": "src/index.ts",
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json",
