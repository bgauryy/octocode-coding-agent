{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"noEmit": false,
		"declaration": true,
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"inlineSources": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["**/*.test.ts"]
}
