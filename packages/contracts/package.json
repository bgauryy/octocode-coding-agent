{
	"name": "@octocodeai/octocode-contracts",
	"version": "1.3.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./backlogs": {
			"source": "./src/backlogs.ts",
			"types": "./dist/backlogs.d.ts",
			"import": "./dist/backlogs.js"
		},
		"./snapshot": {
			"source": "./src/snapshot.ts",
			"types": "./dist/snapshot.d.ts",
			"import": "./dist/snapshot.js"
		},
		"./team": {
			"source": "./src/team.ts",
			"types": "./dist/team.d.ts",
			"import": "./dist/team.js"
		},
		"./workspace": {
			"source": "./src/workspace.ts",
			"types": "./dist/workspace.d.ts",
			"import": "./dist/workspace.js"
		},
		"./protocol": {
			"source": "./src/protocol.ts",
			"types": "./dist/protocol.d.ts",
			"import": "./dist/protocol.js"
		},
		"./daemon": {
			"source": "./src/daemon.ts",
			"types": "./dist/daemon.d.ts",
			"import": "./dist/daemon.js"
		},
		"./config": {
			"source": "./src/config.ts",
			"types": "./dist/config.d.ts",
			"import": "./dist/config.js"
		},
		"./schema": {
			"source": "./src/schema.ts",
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		},
		"./guards": {
			"source": "./src/guards.ts",
			"types": "./dist/guards.d.ts",
			"import": "./dist/guards.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "shx rm -rf dist",
		"prepublishOnly": "yarn run clean && yarn run build",
		"test": "vitest run"
	},
	"dependencies": {
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
