{
	"name": "@octocodeai/octocode-tui-ink",
	"private": true,
	"version": "1.3.0",
	"description": "Ink and React host for the Octocode terminal UI: screen modes, input bridge, clock and theme contexts",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "shx rm -rf dist && tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "yarn run clean && yarn run build"
	},
	"files": [
		"dist/**/*",
		"README.md"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bgauryy/octocodecode.git",
		"directory": "packages/tui-ink"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"@octocodeai/octocode-tui": "1.3.0",
		"ink": "8.0.0",
		"react": "19.3.1"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"ink-testing-library": "4.0.0",
		"shx": "0.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	}
}
