		{
			"name": "api_replay",
			"description": "Replay a discovered request once; page the saved response",
			"inputSchema": {
				"type": "object",
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"properties": {
					"args": {
						"default": [],
						"description": "Existing CLI arguments, passed directly without a shell.",
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				},
				"additionalProperties": false
			}
		},
		{
			"name": "artifact",
			"description": "Page any saved JSON, text or binary capture",
			"inputSchema": {
				"type": "object",
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"properties": {
					"args": {
						"default": [],
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"file": {
						"type": "string",
						"minLength": 1
					},
					"format": {
						"type": "string",
						"enum": [
							"text",
							"json",
							"binary"
						]
					},
					"pointer": {
						"type": "string"
					},
					"offset": {
						"type": "integer",
						"minimum": 0,
						"maximum": 9007199254740991
					},
					"length": {
						"type": "integer",
						"exclusiveMinimum": 0,
						"maximum": 20000
					},
					"sha256": {
						"type": "string",
						"pattern": "^[a-f0-9]{64}$"
					}
				},
				"additionalProperties": false
			}
		},
		{
			"name": "cdp",
			"description": "Execute an installed Domain.method with open params; protocol discovers its installed contract.",
			"inputSchema": {
				"type": "object",
				"$schema": "https://json-schema.org/draft/2020-12/schema",
				"properties": {
					"connection": {
						"type": "object",
