							"port": {
								"description": "Chrome debugging port; default 9222.",
								"type": "integer",
								"exclusiveMinimum": 0,
								"maximum": 65535
							},
							"target": {
								"description": "Observed exact target id. Exclusive with targetUrl, newTab and browser.",
								"type": "string",
								"minLength": 1
							},
							"targetUrl": {
								"description": "Unique URL substring; ambiguity fails.",
								"type": "string",
								"minLength": 1
							},
							"targetType": {
								"type": "string",
								"minLength": 1
							},
							"newTab": {
								"type": "string",
								"minLength": 1
							},
							"browser": {
								"type": "boolean"
							},
							"closeTab": {
								"type": "boolean"
							},
							"keepTab": {
								"type": "boolean"
							},
							"noReload": {
								"type": "boolean"
							},
							"stealth": {
								"type": "boolean"
							},
							"noStealth": {
								"type": "boolean"
							},
							"timeout": {
								"description": "Per-protocol-request ceiling in milliseconds; default 60000.",
								"type": "integer",
								"exclusiveMinimum": 0,
								"maximum": 9007199254740991
							},
							"scriptTimeout": {
								"description": "Whole engine deadline in milliseconds; default 300000.",
								"type": "integer",
								"exclusiveMinimum": 0,
								"maximum": 9007199254740991
							},
							"verbose": {
								"type": "boolean"
							},
							"dryRun": {
								"type": "boolean"
							}
						},
						"additionalProperties": false,
						"description": "Exact target selection and bounded execution; defaults retain tabs and state."
					},
					"method": {
						"type": "string",
