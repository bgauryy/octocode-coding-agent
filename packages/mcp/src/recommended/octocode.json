{
	"name": "octocode",
	"enabledEnv": "OCTOCODE_MCP",
	"description": "Code search and read; each tool's description says when to use it.",
	"command": "octocode-mcp",
	"inheritEnv": true,
	"env": {
		"WORKSPACE_ROOT": "${workspace}",
		"ALLOWED_PATHS": "${researchRoots}",
		"OCTOCODE_TRUST_PROJECT_LSP_CONFIG": "${untrusted:false}",
		"OCTOCODE_ENABLE_CLONE": "true"
	},
	"install": {
		"npm": "octocode-mcp",
		"version": "20.2.0",
		"bin": "octocode-mcp",
		"hostDependency": true
	},
	"toolExposure": {
		"ghSearchRepo": "onDemand",
		"ghSearchCode": "onDemand",
		"ghStructure": "onDemand",
		"ghGetFileContent": "onDemand",
		"ghSearchHistory": "onDemand",
		"ghGetHistoryItem": "onDemand",
		"ghCloneRepo": "onDemand",
		"artifactSearch": "onDemand",
		"securityCheck": "onDemand"
	},
	"roles": {
		"reader": ["localFetch"],
		"search": ["localSearch", "structureSearch", "astSearch", "lspSearch"],
		"judge": ["clasify"],
		"readOnly": [
			"ghSearchRepo",
			"ghSearchCode",
			"ghStructure",
			"ghGetFileContent",
			"ghSearchHistory",
			"ghGetHistoryItem",
			"ghCloneRepo",
			"artifactSearch",
			"securityCheck"
		]
	}
}
