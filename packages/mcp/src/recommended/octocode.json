{
	"name": "octocode",
	"enabledEnv": "OCTOCODE_MCP",
	"description": "Every code search and read: this checkout (localSearch, structureSearch, localFetch, lspSearch, astSearch), GitHub repositories and package registries; use before bash or web.",
	"exposure": "direct",
	"command": "octocode-mcp",
	"inheritEnv": true,
	"env": {
		"WORKSPACE_ROOT": "${workspace}",
		"ALLOWED_PATHS": "${researchRoots}",
		"OCTOCODE_TRUST_PROJECT_LSP_CONFIG": "${untrusted:false}"
	},
	"install": { "npm": "octocode-mcp", "version": "20.2.0", "bin": "octocode-mcp" },
	"roles": {
		"reader": ["localFetch"],
		"search": ["localSearch", "structureSearch", "astSearch", "lspSearch"],
		"readOnly": [
			"clasify",
			"ghSearchRepo",
			"ghSearchCode",
			"ghStructure",
			"ghGetFileContent",
			"ghSearchHistory",
			"ghGetHistoryItem",
			"artifactSearch"
		]
	}
}
