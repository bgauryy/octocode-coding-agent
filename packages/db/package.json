	},
	"dependencies": {
		"@octocodeai/octocode-common": "1.3.0",
		"@octocodeai/octocode-contracts": "1.3.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	},
	"license": "MIT",
	"engines": {
		"node": ">=24.15.0"
	}
}
