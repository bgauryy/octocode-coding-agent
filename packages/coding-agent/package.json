{
	"name": "@octocodeai/octocodecode",
	"version": "1.3.0",
	"description": "Octocode coding agent CLI with native tools, subagents, and session management",
	"type": "module",
	"octocodeConfig": {
		"name": "octocode",
		"configDir": ".octocode"
	},
	"bin": {
		"octocode": "dist/bundle/cli.js",
		"octocode-api": "dist/bundle/octocode-api.js"
	},
	"main": "./dist/bundle/octocode.js",
	"exports": {
		".": {
			"import": "./dist/bundle/octocode.js"
		},
		"./rpc-entry": {
			"import": "./dist/bundle/rpc-entry.js"
		},
		"./mcp": {
			"import": "./dist/bundle/octocode.js"
		},
		"./mcp/oauth": {
			"import": "./dist/bundle/octocode.js"
		},
		"./mcp/testing": {
			"import": "./dist/bundle/octocode.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"schemas",
		"CHANGELOG.md"
	],
	"octocodeRelease": {
		"runtime": [
			"@octocodeai/octocode-chrome-devtools",
			"@silvia-odwyer/photon-node"
		],
		"registry": {
			"@octocodeai/octocode-native": "20.1.0",
			"octocode": "20.2.0",
			"octocode-mcp": "20.2.0"
		}
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "node ../../scripts/build-coding-agent.mjs",
		"build:binary": "yarn run --top-level build && bun build --compile --no-compile-autoload-bunfig --no-compile-autoload-dotenv ./src/bun/cli.ts ./src/utils/image-resize-worker.ts --outfile dist/binary/octocode && node ../../scripts/stage-binary.mjs dist/binary",
		"test": "vitest --run && vitest --run --config vitest.octocode.config.ts && yarn run test:e2e",
		"test:e2e": "vitest --run --config vitest.e2e.config.ts",
		"test:tmux": "vitest --run --config vitest.octocode.config.ts test/octocode/notify.test.ts test/octocode/terminal-launch-tmux.test.ts test/octocode/fork-launch.test.ts test/octocode/tmux-startup-check.test.ts",
		"test:architecture": "vitest --run --config vitest.octocode.config.ts test/octocode/architecture.test.ts",
		"generate:schemas": "node --import ./scripts/source-resolver.ts scripts/generate-schemas.ts",
		"generate:casefold": "node scripts/generate-casefold.ts",
		"generate:vendor": "node scripts/generate-vendor.ts",
		"generate:prompts": "vitest run --config vitest.e2e.config.ts test/octocode/e2e-agent-context.test.ts -u",
		"generate:references": "node --import ./scripts/source-resolver.ts scripts/generate-references.ts",
		"prepublishOnly": "echo 'Publish with: yarn run publish (from the repository root). It stages the manifest and tests the tarball.' && exit 1"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "2.0.2",
		"@modelcontextprotocol/client": "2.3.1",
		"@modelcontextprotocol/core": "2.3.1",
		"@octocodeai/octocode-agent-core": "1.3.0",
		"@octocodeai/octocode-ai": "1.3.0",
		"@octocodeai/octocode-chrome-devtools": "0.2.0",
		"@octocodeai/octocode-contracts": "1.3.0",
		"@octocodeai/octocode-native": "link:../../../octocode/packages/octocode-native",
		"@octocodeai/octocode-tui": "1.3.0",
		"@octocodeai/octocode-webview": "1.3.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"grok-mermaid": "0.2.3",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.8",
		"minimatch": "10.2.6",
		"octocode": "link:../../../octocode/packages/octocode",
		"octocode-mcp": "link:../../../octocode/packages/octocode-mcp",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.5",
		"smol-toml": "1.9.1",
		"typebox": "1.3.27",
		"undici": "8.12.3",
		"web-tree-sitter": "0.25.10",
		"ws": "8.22.0",
		"yaml": "2.9.0",
		"zod": "4.6.7",
		"zustand": "5.0.15"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	},
	"devDependencies": {
		"@octocodeai/octocode-acp": "workspace:*",
		"@octocodeai/octocode-common": "workspace:*",
		"@octocodeai/octocode-db": "workspace:*",
		"@octocodeai/octocode-mcp": "workspace:*",
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/node": "24.19.2",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"@types/ws": "8.18.1",
		"highlight.js-browser": "npm:highlight.js@11.12.0",
		"marked": "18.1.1",
		"shx": "0.4.0",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "bgauryy",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bgauryy/octocodecode.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=24.15.0"
	}
}
