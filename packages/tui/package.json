{
	"name": "@octocodeai/octocode-tui",
	"private": true,
	"version": "1.3.0",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./ansi": {
			"source": "./src/utils/ansi-codes.ts",
			"types": "./dist/utils/ansi-codes.d.ts",
			"import": "./dist/utils/ansi-codes.js"
		},
		"./text": {
			"source": "./src/utils/text.ts",
			"types": "./dist/utils/text.d.ts",
			"import": "./dist/utils/text.js"
		},
		"./multiplexer": {
			"source": "./src/multiplexer.ts",
			"types": "./dist/multiplexer.d.ts",
			"import": "./dist/multiplexer.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "shx rm -rf dist && tsc -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:linux": "native/linux/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"test": "node --test --test-global-setup=../../node-test.global.ts --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"test:tmux": "node --test --test-global-setup=../../node-test.global.ts --test-reporter=spec test/multiplexer.test.ts test/*tmux*.test.ts",
		"prepublishOnly": "yarn run clean && yarn run build"
	},
	"files": [
		"dist/**/*",
		"native/napi.h",
		"native/clipboard.h",
		"native/win32/prebuilds/**/*.node",
		"native/win32/src/**/*.c",
		"native/win32/build.mjs",
		"native/win32/README.md",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/src/**/*.m",
		"native/darwin/build.sh",
		"native/darwin/README.md",
		"native/linux/prebuilds/**/*.node",
		"native/linux/src/**/*.{c,h}",
		"native/linux/build.sh",
		"native/linux/README.md",
		"docs",
		"README.md"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bgauryy/octocodecode.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.6.0",
		"marked": "18.1.1"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@xterm/headless": "5.5.0",
		"chalk": "6.0.0",
		"shx": "0.4.0",
		"typescript": "7.0.2"
	}
}
