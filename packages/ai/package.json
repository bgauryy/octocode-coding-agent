			"types": "./dist/utils/validation.d.ts",
			"import": "./dist/utils/validation.js"
		},
		"./utils/vision": {
			"types": "./dist/utils/vision.d.ts",
			"import": "./dist/utils/vision.js"
		},
		"./bedrock-provider": {
			"types": "./dist/bedrock-provider.d.ts",
			"import": "./dist/bedrock-provider.js"
		},
		"./vertex-node-provider": {
			"types": "./dist/vertex-node-provider.d.ts",
			"import": "./dist/vertex-node-provider.js"
		},
		"./bun-oauth": {
			"types": "./dist/bun-oauth.d.ts",
			"import": "./dist/bun-oauth.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"generate-models": "node scripts/generate-models.ts --strict",
		"hydrate-model-data": "node scripts/generate-models.ts --strict --data-only",
		"check:model-data": "node scripts/check-model-data.ts",
		"build": "node scripts/check-model-data.ts && shx rm -rf dist && tsc -p tsconfig.build.json && shx cp -r src/providers/data dist/providers/data",
		"test": "vitest --run",
		"test:live": "OCTOCODE_LIVE_TESTS=1 vitest --run .live.test.",
		"prepublishOnly": "yarn run clean && yarn run build"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "5.0.142",
		"@ai-sdk/anthropic": "4.0.105",
		"@ai-sdk/azure": "4.0.126",
		"@ai-sdk/google": "4.0.121",
		"@ai-sdk/google-vertex": "5.0.141",
		"@ai-sdk/mistral": "4.0.87",
		"@ai-sdk/openai": "4.0.118",
		"@ai-sdk/openai-compatible": "3.0.92",
		"@ai-sdk/provider": "4.0.38",
		"@ai-sdk/provider-utils": "5.0.81",
		"@aws-sdk/credential-providers": "3.1169.0",
		"@octocodeai/octocode-common": "1.3.0",
		"@octocodeai/octocode-contracts": "1.3.0",
		"@octocodeai/octocode-telemetry": "1.3.0",
		"ai": "7.0.173",
		"aws4fetch": "1.0.20",
		"google-auth-library": "11.3.4",
		"jose": "6.2.17",
		"partial-json": "0.1.7",
		"typebox": "1.4.7",
		"zod": "4.6.7"
	},
	"keywords": [
		"ai",
		"llm",
		"openai",
		"anthropic",
		"gemini",
		"bedrock",
		"unified",
		"api"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bgauryy/octocodecode.git",
		"directory": "packages/ai"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"shx": "0.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.1.0"
	}
}
