			"types": "./dist/utils/abort.d.ts",
			"import": "./dist/utils/abort.js"
		},
		"./utils/assistant-message": {
			"types": "./dist/utils/assistant-message.d.ts",
			"import": "./dist/utils/assistant-message.js"
		},
		"./utils/cache-capabilities": {
			"types": "./dist/utils/cache-capabilities.d.ts",
			"import": "./dist/utils/cache-capabilities.js"
		},
		"./utils/cache-policy": {
			"types": "./dist/utils/cache-policy.d.ts",
