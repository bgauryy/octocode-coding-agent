			"types": "./dist/utils/estimate.d.ts",
			"import": "./dist/utils/estimate.js"
		},
		"./utils/headers": {
			"types": "./dist/utils/headers.d.ts",
			"import": "./dist/utils/headers.js"
		},
		"./utils/image-input": {
			"types": "./dist/utils/image-input.d.ts",
			"import": "./dist/utils/image-input.js"
		},
		"./utils/instruction-split": {
			"types": "./dist/utils/instruction-split.d.ts",
			"import": "./dist/utils/instruction-split.js"
		},
		"./utils/json-schema-shape": {
			"types": "./dist/utils/json-schema-shape.d.ts",
			"import": "./dist/utils/json-schema-shape.js"
		},
		"./utils/mime": {
			"types": "./dist/utils/mime.d.ts",
