			"types": "./dist/utils/model-text.d.ts",
			"import": "./dist/utils/model-text.js"
		},
		"./utils/oauth-page": {
			"types": "./dist/utils/oauth-page.d.ts",
			"import": "./dist/utils/oauth-page.js"
		},
		"./utils/provider-env": {
			"types": "./dist/utils/provider-env.d.ts",
			"import": "./dist/utils/provider-env.js"
		},
		"./utils/provider-host": {
			"types": "./dist/utils/provider-host.d.ts",
