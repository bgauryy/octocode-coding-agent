{
	"name": "@octocodeai/octocode-webview",
	"private": true,
	"version": "1.3.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"license": "MIT",
	"scripts": {
		"build": "shx rm -rf dist && tsc -p tsconfig.build.json",
		"clean": "shx rm -rf dist",
		"prepublishOnly": "yarn run clean && yarn run build",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@octocodeai/octocode-contracts": "1.3.0",
		"dompurify": "3.4.17",
		"highlight.js": "11.12.0",
		"marked": "18.1.1",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/jsdom": "30.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"jsdom": "30.1.3",
		"mermaid": "12.2.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shx": "0.4.0",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
