{
	"name": "@octocodeai/octocode-webview",
	"version": "1.3.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./state": {
			"source": "./src/state.ts",
			"types": "./dist/state.d.ts",
			"import": "./dist/state.js"
		},
		"./markdown": {
			"source": "./src/markdown.ts",
			"types": "./dist/markdown.d.ts",
			"import": "./dist/markdown.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"license": "MIT",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "shx rm -rf dist",
		"test": "vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@octocodeai/octocode-contacts": "1.3.0",
		"dompurify": "3.4.17",
		"highlight.js": "11.12.0",
		"marked": "18.1.1",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/jsdom": "30.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"jsdom": "30.1.3",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shx": "0.4.0",
		"vitest": "4.1.12"
	}
}
