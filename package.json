{
	"name": "@octocodeai/octocode-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"start": "node --import ./packages/coding-agent/scripts/source-resolver.ts ./packages/coding-agent/src/cli.ts",
		"clean": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo run clean",
		"build": "yarn run generate:models && yarn run build:offline",
		"build:offline": "yarn workspaces foreach --all --topological-dev --parallel --exclude @octocodeai/octocode-monorepo run build && yarn workspace @octocodeai/octocodecode run generate:prompts --fail-open",
		"build:native:darwin": "yarn workspace @octocodeai/octocode-tui run build:native:darwin",
		"build:native:linux": "yarn workspace @octocodeai/octocode-tui run build:native:linux",
		"build:native:win32": "yarn workspace @octocodeai/octocode-tui run build:native:win32",
		"check": "node scripts/run-checks.mjs typecheck lint format:check check:browser-smoke check:workspace check:favicon check:boundaries check:db-boundary check:unused",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint packages scripts",
		"lint:fix": "oxlint packages scripts --fix",
		"audit": "yarn npm audit --recursive --environment production --severity moderate",
		"format": "oxfmt \"packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs}\" \"scripts/**/*.{ts,mjs,js}\"",
		"format:check": "oxfmt --check \"packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs}\" \"scripts/**/*.{ts,mjs,js}\"",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"check:package-install": "node scripts/check-package-install.mjs",
		"check:install-lock:coding-agent": "node scripts/generate-coding-agent-install-lock.mjs --check",
		"generate:models": "yarn workspace @octocodeai/octocode-ai run generate-models",
		"hydrate:model-data": "yarn workspace @octocodeai/octocode-ai run hydrate-model-data",
		"check:model-data": "yarn workspace @octocodeai/octocode-ai run check:model-data",
		"diff:model-catalog": "node scripts/diff-model-catalog.mjs",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "node scripts/test-workspaces.mjs",
		"test:scripts": "node --test \"scripts/*.test.mjs\" \"scripts/*.test.ts\" \"scripts/agent-eval/test/*.test.mjs\"",
		"test:tmux": "yarn workspace @octocodeai/octocode-tui run test:tmux && yarn workspace @octocodeai/octocodecode run test:tmux",
		"test:mcp-conformance": "node packages/mcp/test/conformance/run.ts",
		"version:patch": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo version patch --immediate && node scripts/sync-versions.js && yarn install --mode=update-lockfile",
		"version:minor": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo version minor --immediate && node scripts/sync-versions.js && yarn install --mode=update-lockfile",
		"version:major": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo version major --immediate && node scripts/sync-versions.js && yarn install --mode=update-lockfile",
		"version:set": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo version --immediate",
		"prepublishOnly": "yarn run clean && yarn run build && yarn run check",
		"publish": "yarn run prepublishOnly && node scripts/publish.mjs",
		"publish:dry": "yarn run prepublishOnly && node scripts/publish.mjs --dry-run",
		"release:local": "node scripts/local-release.mjs",
		"pack:packages": "node scripts/pack-packages.mjs",
		"install-lock:coding-agent": "node scripts/generate-coding-agent-install-lock.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"release:fix-links": "node scripts/release-notes.mjs fix-github-releases",
		"generate:workspace": "node scripts/build-workspace-state.mjs",
		"check:workspace": "node scripts/build-workspace-state.mjs --check",
		"generate:favicon": "node scripts/generate-favicon.mjs",
		"check:favicon": "node scripts/generate-favicon.mjs --check",
		"check:boundaries": "node scripts/check-package-boundaries.mjs && node scripts/sdk-reachability.mjs && yarn workspace @octocodeai/octocodecode run test:architecture",
		"check:db-boundary": "node scripts/check-db-boundary.mjs",
		"check:unused": "knip --no-progress"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"knip": "6.42.1",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2004",
		"pnpm": "11.15.1",
		"rolldown": "1.2.15",
		"semver": "7.8.5",
		"typescript": "7.0.2",
		"vitest": "4.1.12",
		"web-tree-sitter": "0.25.10",
		"yaml": "2.9.0"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"version": "0.0.3",
	"packageManager": "yarn@4.18.1",
	"resolutions": {
		"protobufjs": "7.6.6"
	}
}
