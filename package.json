{
	"name": "@octocodeai/octocode-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"start": "node --import ./packages/coding-agent/scripts/source-resolver.ts ./packages/coding-agent/src/cli.ts",
		"clean": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo run clean",
		"build": "yarn run generate:models && yarn run build:offline",
		"build:offline": "node scripts/build/build-offline.mjs",
		"build:native:darwin": "yarn workspace @octocodeai/octocode-tui run build:native:darwin",
		"build:native:linux": "yarn workspace @octocodeai/octocode-tui run build:native:linux",
		"build:native:win32": "yarn workspace @octocodeai/octocode-tui run build:native:win32",
		"check": "node scripts/check/run-checks.mjs typecheck lint format:check check:browser-smoke check:subpaths check:workspace check:favicon check:boundaries check:db-boundary check:mcp-boundary check:live-tests check:test-trust check:references check:doc-links check:unused",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint packages scripts",
		"lint:fix": "oxlint packages scripts --fix",
		"audit": "yarn npm audit --recursive --environment production --severity moderate",
		"format": "oxfmt \"packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs}\" \"scripts/**/*.{ts,mjs,js}\"",
		"format:check": "oxfmt --check \"packages/**/*.{ts,tsx,mts,cts,js,mjs,cjs}\" \"scripts/**/*.{ts,mjs,js}\"",
		"check:browser-smoke": "node scripts/check/check-browser-smoke.mjs",
		"check:package-install": "node scripts/release/check-package-install.mjs",
		"check:install-lock:coding-agent": "node scripts/release/install-lock/generate-coding-agent-install-lock.mjs --check",
		"generate:models": "yarn workspace @octocodeai/octocode-ai run generate-models",
		"hydrate:model-data": "yarn workspace @octocodeai/octocode-ai run hydrate-model-data",
		"check:model-data": "yarn workspace @octocodeai/octocode-ai run check:model-data",
		"test": "node scripts/test/test-workspaces.mjs",
		"test:changed": "yarn workspace @octocodeai/octocode-agent run vitest --run --config vitest.octocode.config.ts --changed",
		"test:scripts": "node --test --test-global-setup=node-test.global.ts \"scripts/{build,check,lib,release,test}/**/*.test.{mjs,ts}\"",
		"test:agentic": "yarn workspace @octocodeai/octocode-agentic-testkit run test && node --test --test-global-setup=node-test.global.ts \"scripts/agent-eval/test/*.test.mjs\"",
		"test:tmux": "yarn workspace @octocodeai/octocode-tui run test:tmux && yarn workspace @octocodeai/octocode-agent run test:tmux",
		"test:mcp-conformance": "node packages/mcp/test/conformance/run.ts",
		"version:patch": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo version patch --immediate && node scripts/release/sync-versions.js && yarn install --mode=update-lockfile",
		"version:minor": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo version minor --immediate && node scripts/release/sync-versions.js && yarn install --mode=update-lockfile",
		"version:major": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo version major --immediate && node scripts/release/sync-versions.js && yarn install --mode=update-lockfile",
		"version:set": "yarn workspaces foreach --all --exclude @octocodeai/octocode-monorepo version --immediate",
		"prepublishOnly": "yarn run clean && yarn run build && yarn run check",
		"publish": "yarn run prepublishOnly && node scripts/release/publish.mjs",
		"publish:dry": "yarn run prepublishOnly && node scripts/release/publish.mjs --dry-run",
		"pack-smoke:testkit": "node scripts/release/pack-smoke.mjs",
		"release:local": "node scripts/release/local-release.mjs",
		"pack:packages": "node scripts/release/pack-packages.mjs",
		"install-lock:coding-agent": "node scripts/release/install-lock/generate-coding-agent-install-lock.mjs",
		"release:patch": "node scripts/release/release.mjs patch",
		"release:minor": "node scripts/release/release.mjs minor",
		"release:major": "node scripts/release/release.mjs major",
		"release:fix-links": "node scripts/release/release-notes.mjs fix-github-releases",
		"generate:workspace": "node scripts/build/build-workspace-state.mjs",
		"check:subpaths": "node scripts/check/check-workspace-subpaths.mjs",
		"check:workspace": "node scripts/build/build-workspace-state.mjs --check",
		"generate:favicon": "node scripts/build/generate-favicon.mjs",
		"check:favicon": "node scripts/build/generate-favicon.mjs --check",
		"check:boundaries": "node scripts/check/check-package-boundaries.mjs && node scripts/check/sdk-reachability.mjs && yarn workspace @octocodeai/octocode-agent run test:architecture",
		"check:db-boundary": "node scripts/check/check-db-boundary.mjs",
		"check:mcp-boundary": "node scripts/check/check-mcp-boundary.mjs",
		"check:live-tests": "node scripts/check/check-live-tests.mjs",
		"check:test-trust": "node scripts/check/test-trust.mjs",
		"check:references": "node --import ./packages/coding-agent/scripts/source-resolver.ts packages/coding-agent/scripts/reference-pages/check.ts",
		"check:doc-links": "node scripts/check/check-doc-links.mjs",
		"check:unused": "knip --no-progress"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"knip": "^6.47.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2008",
		"pnpm": "^12.22.0",
		"rolldown": "^1.3.3",
		"semver": "^7.8.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"web-tree-sitter": "^0.27.2",
		"yaml": "^2.9.1"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"version": "0.0.3",
	"packageManager": "yarn@4.18.1",
	"resolutions": {
		"protobufjs": "7.6.6"
	}
}
