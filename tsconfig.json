{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"jsx": "react-jsx",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@octocodeai/octocode-telemetry": ["./packages/telemetry/src/index.ts"],
			"@octocodeai/octocode-ai": ["./packages/ai/src/index.ts"],
			"@octocodeai/octocode-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@octocodeai/octocode-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@octocodeai/octocode-ai/dist/*": ["./packages/ai/src/*"],
			"@octocodeai/octocode-agent-core": ["./packages/agent/src/index.ts"],
			"@octocodeai/octocode-agent": ["./packages/coding-agent/src/index.ts"],
			"@octocodeai/octocode-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@octocodeai/octocode-agent/*": ["./packages/coding-agent/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@octocodeai/octocode-tui": ["./packages/tui/src/index.ts"],
			"@octocodeai/octocode-tui/ansi": ["./packages/tui/src/utils/ansi-codes.ts"],
			"@octocodeai/octocode-tui/text": ["./packages/tui/src/utils/text.ts"],
			"@octocodeai/octocode-tui/multiplexer": ["./packages/tui/src/multiplexer.ts"],
			"@octocodeai/octocode-tui/*": ["./packages/tui/src/*"],
			"@octocodeai/octocode-contracts": ["./packages/contracts/src/index.ts"],
			"@octocodeai/octocode-contracts/*": ["./packages/contracts/src/*.ts"],
			"@octocodeai/octocode-projections": ["./packages/projections/src/index.ts"],
			"@octocodeai/octocode-webview": ["./packages/webview/src/index.ts"],
			"@octocodeai/octocode-webview/*": ["./packages/webview/src/*.ts"],
			"@octocodeai/octocode-agent/mcp": ["./packages/mcp/src/client/index.ts"],
			"@octocodeai/octocode-agent/mcp/oauth": ["./packages/mcp/src/client/oauth/index.ts"],
			"@octocodeai/octocode-mcp": ["./packages/mcp/src/client/index.ts"],
			"@octocodeai/octocode-mcp/oauth": ["./packages/mcp/src/client/oauth/index.ts"],
			"@octocodeai/octocode-mcp/testing": ["./packages/mcp/src/client/testing/index.ts"],
			"@octocodeai/octocode-mcp/host": ["./packages/mcp/src/index.ts"],
			"@octocodeai/octocode-db": ["./packages/db/src/api.ts"],
			"@octocodeai/octocode-common/*": ["./packages/common/src/*.ts"]
		}
	},
	"include": [
		"packages/*/src/**/*",
		"packages/*/test/**/*",
		"packages/ai/scripts/**/*",
		"packages/coding-agent/scripts/source-resolver.ts",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": ["**/dist/**"]
}
