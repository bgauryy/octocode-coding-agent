{
	"$schema": "https://unpkg.com/knip@6.45.1/schema.json",
	"workspaces": {
		".": {
			// `scripts/build/build-workspace-state.mjs` reads Mermaid from the webview workspace's dependency (listed there).
			"ignoreDependencies": ["mermaid"],
			// Build inputs and developer commands invoked by path rather than static imports.
			"entry": [
				"scripts/agent-eval/{run,compare}.mjs",
				"scripts/agent-eval/fixtures/checks/*.mjs",
				"scripts/check/agent-treeshake-smoke-entry.ts",
				"scripts/check/browser-smoke-entry.ts",
				"scripts/release/stage-registry-release.mjs",
				"scripts/release/use-local-packages.mjs",
				// `node --test --test-global-setup` (root and tui test scripts).
				"node-test.global.ts",
			],
		},
		"packages/ai": {
			// Ollama is an optional live-test server, not an npm binary dependency.
			"ignoreBinaries": ["ollama"],
			// Tool search, transcript loading and system updates share one current model list,
			// but their independently consumed capability contracts must remain separate.
			"ignoreIssues": { "scripts/generate-models/constants.ts": ["duplicates"] },
			// The named (non-wildcard) `exports` subpaths, which Knip cannot map from `dist`. The wildcard
			// subpaths (`./providers/*`, `./api/*`, `./utils/*`) are deliberately not entries: a module there counts as
			// used only when this repository imports it, so an export nothing consumes is reported instead of hidden.
			// `providers/compat-schema.ts` is imported by name from coding-agent's `scripts/generate-references.ts`, which
			// Knip does not resolve to ai sources.
			"entry": ["src/index.ts", "src/{models,compat,bedrock-provider,bun-oauth}.ts", "src/providers/compat-schema.ts"],
		},
		"packages/coding-agent": {
			// Resolved by name or path at runtime: the native MCP launcher and the sibling `octocode` CLI from package.json,
			// the browser preset's package (`BROWSER_PACKAGE`), the native binary through its resolver (`config.ts`), and the
			// private ACP, MCP, DB and terminal workspaces, whose sources are compiled into this package.
			"ignoreDependencies": [
				"octocode-mcp",
				"octocode",
				"@octocodeai/octocode-chrome-devtools",
				"@octocodeai/octocode-native",
				"@octocodeai/octocode-acp",
				"@octocodeai/octocode-db",
				"@octocodeai/octocode-terminal",
				// Imported by the private common and MCP workspaces, whose sources compile into this package.
				"cross-spawn",
				"@types/cross-spawn",
				"@octocodeai/octocode-mcp",
				// Imported by private MCP sources compiled into the published coding-agent package.
				"@modelcontextprotocol/client",
				"@modelcontextprotocol/core",
				// highlight.js 11 under an alias; `scripts/generate-vendor.ts` bundles it by name for the HTML export.
				"highlight.js-browser",
			],
			// Platform commands and optional test prerequisites, not npm packages.
			// `sqlite3` reads Cursor's chat databases in the `resume-external-harness` skill script and its test.
			// `lldb` and `go` run the `octocode-debugging` skill's commands in its test, skipped where absent.
			"ignoreBinaries": ["perl", "pwsh", "where", "trash", "uv", "sqlite3", "lldb", "go"],
			// Bundler/worker inputs and shipped extensions are selected by path at runtime.
			"entry": [
				"src/index.ts",
				"src/bundle.ts",
				"src/rpc-entry.ts",
				"src/bun/cli.ts",
				"src/utils/image-resize-worker.ts",
				// Started by URL from `src/octocode/history/index/client.ts`.
				"src/octocode/history/index/worker-entry.ts",
				"src/octocode/api/cli.ts",
				"scripts/generate-{schemas,references}.ts",
				"scripts/generate-codex-hook-output-fixtures.mjs",
				// Bundled skill scripts the agent runs with node by path.
				"src/octocode/native/skills/*/scripts/*.mjs",
			],
			// Vendored scripts are generated by `generate:vendor`; the page script fragments are listed in template-script.ts. Exports inline both as text; neither is imported as an application module.
			"ignore": ["src/core/export-html/vendor/**", "src/core/export-html/script/**"],
		},
		"packages/db": {
			// The database writer's worker file is started by URL from source (`src/writer/client.ts`).
			"entry": ["src/writer/worker-entry.ts"],
			// Common sources are bundled into the same host and imported by relative source path.
			"ignoreDependencies": ["@octocodeai/octocode-common"],
		},
		"packages/tui": {
			// Linux clipboard integration tests use a system compiler and X11 clipboard tool.
			"ignoreBinaries": ["cc"],
		},
		"packages/webview": {
			// The offline bundle substitutes its own entry through a Rolldown resolver.
			"entry": ["src/{state,markdown}.ts", "src/page.tsx", "src/app/live/offline.ts"],
		},
	},
}
