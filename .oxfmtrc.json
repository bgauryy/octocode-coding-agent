{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"printWidth": 120,
	"singleQuote": false,
	"trailingComma": "all",
	"arrowParens": "always",
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/dist/",
		"**/node_modules/",
		"**/coverage/",
		"**/*.generated.ts",
		"packages/ai/src/providers/data/",
		"packages/coding-agent/src/core/export-html/vendor/",
		"**/fixtures/",
		".yarn/",
		"yarn.lock"
	]
}
