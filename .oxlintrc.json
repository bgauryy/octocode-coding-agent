{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"options": {
		"typeAware": true,
		"reportUnusedDisableDirectives": "error"
	},
	"env": { "node": true, "es2024": true },
	"ignorePatterns": [
		"**/dist/**",
		"**/node_modules/**",
		"**/coverage/**",
		"**/*.generated.ts",
		"**/*.d.ts",
		"packages/ai/src/providers/data/**",
		"packages/coding-agent/src/core/export-html/vendor/**",
		"packages/coding-agent/examples/**",
		"**/fixtures/**"
	],
	"rules": {
		"max-lines": ["error", { "max": 400 }],
		"no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none", "ignoreRestSiblings": true }],
		"typescript/consistent-type-imports": "error",
		"typescript/no-explicit-any": "off",
		"import/no-duplicates": "error",
		"import/no-self-import": "error",
		"import/no-cycle": "error",
		"no-var": "error",
		"prefer-const": "error"
	},
	"overrides": [
		{
			"files": ["packages/webview/src/**", "packages/webview/test/**"],
			"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "react-perf"],
			"env": { "browser": true },
			"rules": {
				"no-console": "error",
				"react/rules-of-hooks": "error",
				"react/exhaustive-deps": "error",
				"react/no-danger": "error",
				"react/no-array-index-key": "error"
			}
		},
		{
			"files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs"],
			"rules": { "max-lines": "off" }
		}
	]
}
