{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise"],
	"categories": {
		"correctness": "error"
	},
	"options": {
		"typeAware": true,
		"reportUnusedDisableDirectives": "error"
	},
	"env": {
		"node": true,
		"es2024": true
	},
	"ignorePatterns": [
		"**/dist/**",
		"**/node_modules/**",
		"**/coverage/**",
		"**/*.generated.ts",
		"**/*.d.ts",
		"packages/ai/src/providers/data/**",
		"packages/coding-agent/src/core/export-html/vendor/**",
		"**/fixtures/**"
	],
	"rules": {
		"max-lines": [
			"error",
			{
				"max": 400
			}
		],
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrors": "none",
				"ignoreRestSiblings": true
			}
		],
		"no-var": "error",
		"prefer-const": "error",
		"no-useless-concat": "error",
		"no-useless-escape": "error",
		"typescript/consistent-type-imports": "error",
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/no-unnecessary-type-arguments": "error",
		"typescript/no-unnecessary-boolean-literal-compare": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/await-thenable": "error",
		"typescript/no-misused-spread": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-base-to-string": "error",
		"typescript/restrict-template-expressions": "error",
		"import/no-duplicates": "error",
		"import/no-self-import": "error",
		"import/no-cycle": ["error", { "ignoreTypes": false }],
		"unicorn/no-useless-spread": "error",
		"unicorn/no-useless-fallback-in-spread": "error",
		"typescript/only-throw-error": "error",
		"typescript/prefer-promise-reject-errors": ["error", { "allowThrowingAny": true, "allowThrowingUnknown": true }],
		"eslint/preserve-caught-error": "error",
		"typescript/return-await": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-deprecated": "error",
		"oxc/no-accumulating-spread": "error",
		"unicorn/prefer-node-protocol": "error",
		"typescript/no-unnecessary-template-expression": "error",
		"typescript/no-unnecessary-type-conversion": "error",
		"unicorn/prefer-array-flat-map": "error",
		"no-useless-return": "error",
		"no-empty": "error",
		"no-case-declarations": "error",
		"no-unexpected-multiline": "error",
		"no-self-compare": "error",
		"no-fallthrough": "error",
		"no-implied-eval": "error",
		"no-new-wrappers": "error",
		"no-extend-native": "error",
		"no-useless-constructor": "error",
		"no-useless-computed-key": "error",
		"eqeqeq": ["error", "smart"],
		"typescript/ban-ts-comment": "error",
		"typescript/no-unsafe-function-type": "error",
		"typescript/prefer-reduce-type-parameter": "error",
		"typescript/no-namespace": "error",
		"typescript/no-mixed-enums": "error",
		"unicorn/error-message": "error",
		"unicorn/throw-new-error": "error",
		"unicorn/no-useless-switch-case": "error",
		"unicorn/prefer-regexp-test": "error",
		"promise/no-return-wrap": "error",
		"typescript/prefer-nullish-coalescing": [
			"error",
			{ "ignorePrimitives": { "string": true, "boolean": true, "bigint": true } }
		],
		"typescript/no-empty-object-type": ["error", { "allowInterfaces": "with-single-extends" }],
		"typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
		"no-console": "error",
		"no-param-reassign": "error",
		"no-multi-assign": "error",
		"promise/no-nesting": "error",
		"default-param-last": "error",
		"unicorn/no-useless-collection-argument": "error",
		"no-control-regex": "off",
		"typescript/unbound-method": "off"
	},
	"overrides": [
		{
			"files": ["packages/*/src/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "node:sqlite",
								"message": "SQL belongs in packages/db/src/queries. Call it through packages/db/src/api.ts."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/db/src/**", "packages/coding-agent/src/octocode/team/peer-leases.ts"],
			"rules": {
				"no-restricted-imports": "off"
			}
		},
		{
			"files": [
				"scripts/**",
				"**/scripts/**",
				"**/test/**",
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.test.mjs",
				"packages/tui/native/**",
				"packages/ai/src/cli.ts",
				"packages/mcp/src/cli.ts",
				"packages/coding-agent/src/main.ts",
				"packages/coding-agent/src/main/**",
				"packages/coding-agent/src/cli/**",
				"packages/coding-agent/src/package-manager-cli.ts",
				"packages/coding-agent/src/package-manager-cli/**",
				"packages/coding-agent/src/modes/print-mode.ts",
				"packages/coding-agent/src/octocode/api/cli.ts",
				"packages/coding-agent/src/octocode/context-optimization/command.ts",
				"packages/coding-agent/src/octocode/plugins/marketplace/command.ts",
				"packages/coding-agent/src/core/timings.ts",
				"packages/coding-agent/src/modes/interactive/interactive-mode/crash-reporting.ts",
				"packages/coding-agent/src/core/export-html/script/**"
			],
			"rules": {
				"no-console": "off"
			}
		},
		{
			"files": ["packages/webview/src/**", "packages/webview/test/**"],
			"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
			"env": {
				"browser": true
			},
			"rules": {
				"no-console": "error",
				"react/rules-of-hooks": "error",
				"react/exhaustive-deps": "error",
				"react/no-danger": "error",
				"react/no-array-index-key": "error",
				"react/react-in-jsx-scope": "off",
				"typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }]
			}
		},
		{
			"files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs", "scripts/**/*.test.*"],
			"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
			"rules": {
				"vitest/no-focused-tests": "error",
				"vitest/no-identical-title": "error",
				"vitest/no-duplicate-hooks": "error",
				"vitest/no-standalone-expect": "error",
				"vitest/no-commented-out-tests": "error",
				"vitest/no-test-prefixes": "error",
				"vitest/no-test-return-statement": "error",
				"vitest/valid-describe-callback": "error",
				"vitest/valid-expect-in-promise": "error",
				"vitest/hoisted-apis-on-top": "error",
				"vitest/require-awaited-expect-poll": "error",
				"vitest/no-mocks-import": "error",
				"vitest/no-unneeded-async-expect-function": "error",
				"vitest/no-interpolation-in-snapshots": "error",
				"vitest/valid-expect": "off",
				"vitest/no-conditional-expect": "off",
				"vitest/require-mock-type-parameters": "off",
				"max-lines": "off",
				"typescript/no-floating-promises": "off",
				"typescript/no-base-to-string": "off",
				"typescript/await-thenable": "off",
				"typescript/no-misused-spread": "off",
				"typescript/no-misused-promises": "off",
				"typescript/restrict-template-expressions": "off"
			}
		},
		{
			"files": ["packages/coding-agent/src/core/export-html/script/*.js"],
			"rules": {
				"no-unused-vars": "off",
				"prefer-const": "off"
			}
		}
	]
}
