{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise"],
	"categories": {
		"correctness": "error"
	},
	"options": {
		"typeAware": true,
		"reportUnusedDisableDirectives": "error"
	},
	"env": {
		"node": true,
		"es2024": true
	},
	"ignorePatterns": [
		"**/dist/**",
		"**/node_modules/**",
		"**/coverage/**",
		"**/*.generated.ts",
		"**/*.d.ts",
		"packages/ai/src/providers/data/**",
		"packages/coding-agent/src/core/export-html/vendor/**",
		"**/fixtures/**"
	],
	"rules": {
		"max-lines": [
			"error",
			{
				"max": 400
			}
		],
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrors": "none",
				"ignoreRestSiblings": true
			}
		],
		"no-var": "error",
		"prefer-const": "error",
		"no-useless-concat": "error",
		"no-useless-escape": "error",
		"typescript/consistent-type-imports": "error",
		"typescript/no-unnecessary-type-assertion": "error",
		"typescript/no-unnecessary-type-arguments": "error",
		"typescript/no-unnecessary-boolean-literal-compare": "error",
		"typescript/no-redundant-type-constituents": "error",
		"typescript/await-thenable": "error",
		"typescript/no-misused-spread": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-base-to-string": "error",
		"typescript/restrict-template-expressions": "error",
		"import/no-duplicates": "error",
		"import/no-self-import": "error",
		"import/no-cycle": ["error", { "ignoreTypes": false }],
		"unicorn/no-useless-spread": "error",
		"unicorn/no-useless-fallback-in-spread": "error",
		"typescript/only-throw-error": "error",
		"typescript/prefer-promise-reject-errors": ["error", { "allowThrowingAny": true, "allowThrowingUnknown": true }],
		"eslint/preserve-caught-error": "error",
		"typescript/return-await": "error",
		"typescript/no-misused-promises": "error",
		"typescript/no-deprecated": "error",
		"oxc/no-accumulating-spread": "error",
		"unicorn/prefer-node-protocol": "error",
		"typescript/no-unnecessary-template-expression": "error",
		"typescript/no-unnecessary-type-conversion": "error",
		"unicorn/prefer-array-flat-map": "error",
		"no-useless-return": "error",
		"no-control-regex": "off",
		"typescript/unbound-method": "off"
	},
	"overrides": [
		{
			"files": ["packages/*/src/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"paths": [
							{
								"name": "node:sqlite",
								"message": "SQL belongs in packages/db/src/queries. Call it through packages/db/src/api.ts."
							}
						]
					}
				]
			}
		},
		{
			"files": ["packages/db/src/**", "packages/coding-agent/src/octocode/team/peer-leases.ts"],
			"rules": {
				"no-restricted-imports": "off"
			}
		},
		{
			"files": ["packages/webview/src/**", "packages/webview/test/**"],
			"plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "jsx-a11y"],
			"env": {
				"browser": true
			},
			"rules": {
				"no-console": "error",
				"react/rules-of-hooks": "error",
				"react/exhaustive-deps": "error",
				"react/no-danger": "error",
				"react/no-array-index-key": "error",
				"react/react-in-jsx-scope": "off",
				"typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }]
			}
		},
		{
			"files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs", "scripts/**/*.test.*"],
			"rules": {
				"max-lines": "off",
				"typescript/no-floating-promises": "off",
				"typescript/no-base-to-string": "off",
				"typescript/await-thenable": "off",
				"typescript/no-misused-spread": "off",
				"typescript/no-misused-promises": "off",
				"typescript/restrict-template-expressions": "off"
			}
		},
		{
			"files": ["packages/coding-agent/src/core/export-html/script/*.js"],
			"rules": {
				"no-unused-vars": "off",
				"prefer-const": "off"
			}
		}
	]
}
